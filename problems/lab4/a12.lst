     1                                  
     2                                  ; A12. A string of bytes A is given. Construct string B containing only values divisible with 5 from string A.
     3                                  
     4                                  ; If A = 16, 20, 5, 18 => B = 20, 5
     5                                  
     6                                  bits 32 ; assembling for the 32 bits architecture
     7                                  
     8                                  ; declare the EntryPoint (a label defining the very first instruction of the program)
     9                                  global start        
    10                                  
    11                                  ; declare external functions needed by our program
    12                                  extern exit               ; tell nasm that exit exists even if we won't be defining it
    13                                  import exit msvcrt.dll    ; exit is a function that ends the calling process. It is defined in msvcrt.dll
    14                                                            ; msvcrt.dll contains exit, printf and all the other important C-runtime specific functions
    15                                  
    16                                  ; our data is declared here (the variables needed by our program)
    17                                  segment data use32 class=data
    18 00000000 10140512                    a db 16, 20, 5, 18
    19                                      len_A equ $ - a 
    20                                  
    21 00000004 <res 00000004>              b resb len_A
    22                                  
    23                                  ; our code starts here
    24                                  segment code use32 class=code
    25                                      start:
    26 00000000 BE[00000000]                    mov esi, a 
    27 00000005 BF[04000000]                    mov edi, b 
    28 0000000A B904000000                      mov ecx, len_A 
    29 0000000F FC                              cld 
    30                                      iter:
    31 00000010 AC                              lodsb       ; load byte from [esi] into al, esi ++
    32                                  
    33 00000011 88C3                            mov bl, al  ; prepare div
    34 00000013 B400                            mov ah, 0   
    35 00000015 B205                            mov dl, 5
    36 00000017 F6F2                            div dl      ; al = quotient, ah = remainder, b/b
    37                                  
    38 00000019 80FC00                          cmp ah, 0
    39 0000001C 7503                            jne final
    40 0000001E 88D8                            mov al, bl 
    41 00000020 AA                              stosb 
    42                                      
    43                                      final: 
    44 00000021 E2ED                            loop iter 
    45                                          ; exit(0)
    46 00000023 6A00                            push    dword 0      ; push the parameter for exit onto the stack
    47 00000025 FF15[00000000]                  call    [exit]       ; call exit to terminate the program
